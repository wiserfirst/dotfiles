#!/bin/bash
# herdr-ws-picker — fzf over open herdr workspaces, focus the pick.
#
# Usage:
#   herdr-ws-picker            interactive fzf picker (run inside a terminal)
#   herdr-ws-picker <query>    non-interactive: best fuzzy match wins
#
# Unlike herdr-sessionizer this searches only open workspaces (by label)
# and never creates one.

export PATH="/opt/homebrew/bin:$HOME/.fzf/bin:$PATH"

candidates() {
  herdr workspace list |
    jq -r '.result.workspaces[] | [.label, .workspace_id] | @tsv'
}

query="${1:-}"
if [ -n "$query" ]; then
  line=$(candidates | fzf --filter "$query" --delimiter '\t' --nth 1 | head -1)
else
  line=$(candidates | fzf --prompt="workspace> " --delimiter '\t' --with-nth 1)
fi

if [ -z "$line" ]; then
  echo "no match"
  exit 1
fi

label=$(printf '%s\n' "$line" | cut -f1)
ws_id=$(printf '%s\n' "$line" | cut -f2)

herdr workspace focus "$ws_id" > /dev/null
echo "→ $label"
